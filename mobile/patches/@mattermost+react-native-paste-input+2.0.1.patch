+// sfluv: only a TextInput's own component view is accepted. A tag is a
+// small integer, and UIKit's views use tags too.
+- (nullable UIView *)findTextInputViewInWindowsWithTag:(NSInteger)tag
+{
+    for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+        if (![scene isKindOfClass:[UIWindowScene class]]) {
+            continue;
+        }
+        for (UIWindow *window in ((UIWindowScene *)scene).windows) {
+            UIView *match = [window viewWithTag:tag];
+            if (match && [NSStringFromClass([match class]) hasPrefix:@"RCTTextInputComponentView"]) {
+                return match;
+            }
+        }
+    }
+    return nil;
+}
