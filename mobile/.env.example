EXPO_PUBLIC_CHAIN_ID=80094
EXPO_PUBLIC_RPC_URL=https://rpc.berachain.com

# Legacy Citizen Wallet route
EXPO_PUBLIC_LEGACY_ENTRYPOINT_ADDRESS=0x7079253c0358eF9Fd87E16488299Ef6e06F403B6
EXPO_PUBLIC_LEGACY_ACCOUNT_FACTORY_ADDRESS=0x7cC54D54bBFc65d1f0af7ACee5e4042654AF8185
EXPO_PUBLIC_LEGACY_PAYMASTER_ADDRESS=0x9A5be02B65f9Aa00060cB8c951dAFaBAB9B860cd
EXPO_PUBLIC_LEGACY_PAYMASTER_TYPE=cw-safe
EXPO_PUBLIC_LEGACY_BACKEND_URL=https://80094.engine.citizenwallet.xyz

EXPO_PUBLIC_TOKEN_ADDRESS=0x881cad4f885c6701d8481c0ed347f6d35444ea7e
EXPO_PUBLIC_TOKEN_DECIMALS=18

# Shared SFLUV app backend. Replace localhost with a LAN IP or public host when testing in Expo Go on a real phone.
EXPO_PUBLIC_APP_BACKEND_URL=http://localhost:8080
EXPO_PUBLIC_APP_ORIGIN=https://app.sfluv.org

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAP_ID=

EXPO_PUBLIC_MAX_SMART_ACCOUNT_SCAN=5

# Privy
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Expo push registration. Required for development builds that use push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional for local non-interactive Expo / EAS auth.
EXPO_TOKEN=

# Optional local iOS bundle identifier override for personal dev builds.
IOS_BUNDLE_IDENTIFIER=org.sfluv.wallet

# Sentry error reporting.
#
# The DSN is public by design (it ships in the client bundle), same as the
# Privy app id above. Leave it empty to disable Sentry entirely — local Expo Go
# runs should not report events.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Source-map upload credentials. Build-time only; these are NOT EXPO_PUBLIC_ and
# must never reach the client bundle.
#
# Use this file (mobile/.env), not .env.local — the repo .gitignore ignores
# mobile/.env by exact path, so a token in .env.local would be committed.
SENTRY_ORG=sfluv
SENTRY_PROJECT=sfluv-mobile
SENTRY_AUTH_TOKEN=
